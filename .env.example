# Select exactly one database provider by setting only one flag to true.
DB_SQLITE=true
DB_MYSQL=false
DB_POSTGRES=false

# IMPORTANT:
# - Keep DATABASE_URL aligned with your selected provider.
# - On Vercel production, DB_SQLITE must remain false.

# SQLite (local dev only)
DATABASE_URL="file:./prisma/dev.db"

# MySQL
# DB_SQLITE=false
# DB_MYSQL=true
# DB_POSTGRES=false
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/notes_app"

# PostgreSQL (Vercel-compatible hosted option — Neon, Supabase, Vercel Postgres)
# DB_SQLITE=false
# DB_MYSQL=false
# DB_POSTGRES=true
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/notes_app?sslmode=require"

# ── Authentication ──────────────────────────────────────────────────────────
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=dev-secret-change-in-production

# ── Frontend API base URL ───────────────────────────────────────────────────
# Leave empty when API and frontend share the same Vercel deployment.
VITE_API_BASE_URL=""

