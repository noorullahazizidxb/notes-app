{
  "name": "noorullah-notes-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, offline-first note-taking application built with React and TypeScript.",
  "author": "Noorullah Azizi",
  "license": "MIT",
  "homepage": "https://notes-app-gray-omega.vercel.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings 0",
    "db:select": "node scripts/select-prisma-schema.mjs",
    "prisma:generate": "npm run db:select && prisma generate",
    "prisma:migrate:dev": "npm run db:select && prisma migrate dev",
    "prisma:migrate:deploy": "npm run db:select && prisma migrate deploy",
    "vercel-build": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run build"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@bprogress/react": "^1.2.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@prisma/client": "^6.16.2",
    "@tailwindcss/typography": "^0.5.10",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^6.30.1",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vercel/node": "^5.3.24",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^8.3.1"
  },
  "eslintConfig": {
    "root": true
  },
  "environment": "production"
}
